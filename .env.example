# ============================================================================
# CONFIGURACIÓN DE SUPABASE (Base de Datos y Autenticación)
# Copia este archivo como .env.local y pega tus llaves de Supabase
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-llave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=tu-llave-service-role

# ============================================================================
# PROVEEDORES DE VIDEO EXTERNOS (Bunny.net Stream / Cloudflare Stream)
# ============================================================================
NEXT_PUBLIC_BUNNY_LIBRARY_ID=000000
BUNNY_STREAM_API_KEY=tu-api-key-de-bunny
NEXT_PUBLIC_CLOUDFLARE_CUSTOMER_CODE=customer-demo

# ============================================================================
# PASARELAS DE PAGO (Webhooks de Suscripciones)
# ============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=mp_webhook_secret_...
